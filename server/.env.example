PORT=3001

# ── Google Gemini ──────────────────────────────────────────────
# Your Google Gemini API Key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (e.g. gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase (server-side / admin) ────────────────────────────
# Project URL — found in Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service-role key — found in Supabase → Project Settings → API → service_role
# WARNING: This key bypasses Row Level Security. Keep it SECRET.
# Never commit this value. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
